# Terraform working directory
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform variable files with real values
*.tfvars
*.tfvars.json

# Keep example variable files
!*.tfvars.example

# Terraform lock files
.terraform.lock.hcl

# Terraform crash logs
crash.log
crash.*.log

# Terraform plan files
*.tfplan
*.plan

# Terraform state lock info
.terraform.tfstate.lock.info

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc

# VS Code
.vscode/

# OS files
.DS_Store
Thumbs.db
